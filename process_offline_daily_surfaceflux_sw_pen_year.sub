#!/bin/bash
#PBS -N DSWFXXOUTPUTXX
#PBS -P m35
#PBS -l ncpus=14
#PBS -l mem=64GB
#PBS -l walltime=02:00:00
#PBS -l jobfs=10GB
#PBS -l wd
#PBS -l storage=gdata/xp65+gdata/e14+scratch/e14+gdata/av17
#PBS -q normal

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-25.06

# XOUTPUTX -> output (year) to process

# This script computes an *approximate* offline daily mixed layer surface flux budget, split into:
# - surface_flux: the non-penetrative part of the surface heat flux (swflx + lw_heat + sens_heat + evap_heat),
#                 binned into the daily-average mixed layer. This is purely a 2D (surface layer) quantity.
# - sw_pen:       the shortwave heat absorbed below the surface, reconstructed from the daily swflx using a
#                 monthly vertical absorption fraction g = sw_heat/swflx (see below, computed from this same
#                 output year's own monthly diagnostics), and then binned into the daily-average mixed layer.
#
# Unlike process_offline_daily_budget_month.sub, this does not attempt to close the full mixed layer
# temperature budget (no advection, vertical mixing or correction terms) - only these two surface-flux-derived
# terms are computed - so a full year can be processed in one go. It also uses the *monthly-mean* dzt (from
# ocean_month.nc, available for every output) rather than daily dzt (only archived for output366), applying
# it as a constant approximation across all days within that month - this is what lets this run for any
# output, not just 366.

python3 -c "$(cat << EOF

import xarray as xr
import numpy as np
import os
from tqdm import tqdm
from dask.distributed import Client

client = Client(n_workers=14)

# Settings and paths:
output = XXOUTPUTXX # Year to process (e.g. 366 = 2019)

base = '/g/data/av17/access-nri/OM2/025deg_jra55_iaf_cycle6_online_mlt/'
tmp_folder = '/g/data/e14/rmh561/access-om2/archive/025deg_jra55_iaf_cycle6_online_mlt/post_processed_diags/mlt_budget_offline/'

base2 = base + 'output%03d/ocean/' % output
reg = [None,None,None,None] # Globe
times = '%d' % (1989 + output - 336) # Calendar year corresponding to this output (output 366 = 2019)

chunks2D = {'time':1,'yt_ocean':216,'xt_ocean':240}
chunks3D = {'time':1,'st_ocean':25,'yt_ocean':324,'xt_ocean':360}

rho0 = 1035.
Cp = 3992.10322329649

max_depth = 300. # Only need levels down to this nominal depth - shortwave absorption below this is negligible

def decode_time(ds):
    ds = ds.assign_coords({'time':[np.datetime64('0001-01-01') + np.timedelta64(int(x*86400),'s') for x in ds.time.values]})
    return(ds)

# Determine the nominal level index closest to max_depth from this output's vertical grid, and load the
# monthly-mean dzt (available for every output, unlike the daily 3D budget file which only exists for 2019).
# Keep this dask-backed (not .load()'d) - combining an eagerly-loaded numpy array with the still-chunked
# daily fields below causes dask to duplicate it across every chunk of the other array, which is what blew
# out memory previously:
ds_mon_3d = xr.open_dataset(base2 + 'ocean_month.nc',decode_times=False,chunks=chunks3D).sel(xt_ocean=slice(reg[0],reg[1]),yt_ocean=slice(reg[2],reg[3]))
k_max = int(np.abs(ds_mon_3d.st_edges_ocean.values[1:] - max_depth).argmin())
dzt_mon = ds_mon_3d.dzt.isel(st_ocean=slice(0,k_max+1))
dzt_mon = decode_time(dzt_mon).sel(time=times)

# Compute the monthly shortwave absorption fraction g(month,st_ocean,y,x) = sw_heat/swflx from this output's
# own monthly diagnostics. This fraction is set by the model's (fixed) optical attenuation scheme and the
# seasonal solar cycle, not by year-to-year weather, so there's no need for a multi-year climatology here -
# the only year-to-year variation is the small effect of sea level (zstar) on cell depths.
ds_sw_heat_mon = xr.open_dataset(base2 + 'ocean_budget_month_3d.nc',decode_times=False,chunks=chunks3D).sel(xt_ocean=slice(reg[0],reg[1]),yt_ocean=slice(reg[2],reg[3]))[['sw_heat']].isel(st_ocean=slice(0,k_max+1))
ds_swflx_mon = ds_mon_3d[['swflx']]

ds_sw_heat_mon = decode_time(ds_sw_heat_mon).sel(time=times)
ds_swflx_mon = decode_time(ds_swflx_mon).sel(time=times)

sw_heat_mon = ds_sw_heat_mon.sw_heat
swflx_mon = ds_swflx_mon.swflx

# Avoid dividing by (near) zero swflx (e.g. polar night). Keep g indexed by its real (mid-month) timestamp,
# rather than a 'month' dim, so it can be linearly interpolated onto each day below instead of being treated
# as a step function that jumps at month boundaries. Rechunk 'time' to a single chunk (only 12 months, so
# cheap) so .interp() below can work lazily rather than needing the whole thing eagerly loaded:
g_frac = xr.where(np.abs(swflx_mon)>1.e-10, sw_heat_mon/swflx_mon, 0.).chunk({'time':-1}).rename('g').to_dataset()

# Standard daily diagnostics (2D only - swflx, lw_heat, sens_heat, evap_heat and mld):
ds_day = xr.open_dataset(base2 + 'ocean_daily.nc',decode_times=False,chunks=chunks2D).sel(xt_ocean=slice(reg[0],reg[1]),yt_ocean=slice(reg[2],reg[3]))
ds_day = decode_time(ds_day)
ds_day.average_DT.data = ds_day.average_DT*np.timedelta64(1,'D')
ds_day = ds_day.sel(time=times)

g_frac = g_frac.sel(xt_ocean=slice(reg[0],reg[1]),yt_ocean=slice(reg[2],reg[3]))

def bin_surface_2d_in_mld(da_2d,mld,dzt0):
    """
    Bin a purely surface-layer (non-penetrative) 2D flux into the (daily-average) mixed layer.
    """
    surf_frac = xr.where(dzt0>mld, mld/dzt0, 1.)
    return(surf_frac*da_2d/rho0/Cp/mld)

def bin_3d_in_mld(da_3d,mld,dzt):
    """
    Bin a 3D (depth-penetrating) flux into the (daily-average) mixed layer.
    """
    dzt_bot = dzt.cumsum('st_ocean')   # Depth of bottom of each cell
    dzt_top = dzt_bot - dzt            # Depth of top of each cell

    full_mask = dzt_bot<mld            # Cells lying entirely within the mixed layer
    frac_mask = np.logical_and(dzt_top<mld, dzt_bot>=mld) # Cell straddling the base of the mixed layer
    frac = (mld-dzt_top)/dzt

    da_full = da_3d.where(full_mask).sum('st_ocean')
    da_frac = (da_3d*frac).where(frac_mask).sum('st_ocean')

    return((da_full.fillna(0.)+da_frac.fillna(0.))/rho0/Cp/mld)

# Reconstruct the daily 3D shortwave heating by linearly interpolating the monthly absorption fraction onto
# each day (extrapolating for days before the first/after the last mid-month timestamp), and bin into the
# mixed layer one calendar month at a time: doing the interpolation for all 365 days in one go forces dask to
# materialize the whole year as a single (huge) chunk, which is what blew out memory previously.
mlt_budget_surfaceflux_uncat = []
for month in tqdm(range(1,13)):
    month_str = '%s-%02d' % (times,month)

    ds_day_month = ds_day.sel(time=month_str)
    # Approximation: use this calendar month's mean dzt for every day in the month, since daily dzt isn't
    # archived outside output366:
    dzt_month = dzt_mon.sel(time=month_str).isel(time=0,drop=True)
    dzt0_month = dzt_month.isel(st_ocean=0,drop=True)

    g_month = g_frac.g.interp(time=ds_day_month.time, kwargs={'fill_value':'extrapolate'})
    sw_heat_recon_month = g_month*ds_day_month.swflx
    surface_flux_2d_month = ds_day_month.swflx + ds_day_month.lw_heat + ds_day_month.sens_heat + ds_day_month.evap_heat

    bud_month = xr.Dataset({
        'surface_flux': bin_surface_2d_in_mld(surface_flux_2d_month, ds_day_month.mld, dzt0_month),
        'shortwave': bin_surface_2d_in_mld(ds_day_month.swflx, ds_day_month.mld, dzt0_month),
        'longwave': bin_surface_2d_in_mld(ds_day_month.lw_heat, ds_day_month.mld, dzt0_month),
        'sensible': bin_surface_2d_in_mld(ds_day_month.sens_heat, ds_day_month.mld, dzt0_month),
        'latent': bin_surface_2d_in_mld(ds_day_month.evap_heat, ds_day_month.mld, dzt0_month),
        'sw_pen': bin_3d_in_mld(sw_heat_recon_month, ds_day_month.mld, dzt_month),
    }).load()

    mlt_budget_surfaceflux_uncat.append(bud_month)

mlt_budget_surfaceflux = xr.concat(mlt_budget_surfaceflux_uncat, dim='time')

# Save to file:
fname = tmp_folder + 'mlt_budget_stavg_daily_offline_surfaceflux_output%03d.nc' % output
mlt_budget_surfaceflux.to_netcdf(fname)

EOF
)"
